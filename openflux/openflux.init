#!/bin/sh /etc/rc.common
#
# Выходной узел OpenFlux под procd (OpenWrt).
#
# Ставится в /etc/init.d/openflux, настройки читает из /etc/openflux/openflux.env.
#
# Запуск узла именно на роутере даёт то, ради чего всё затевалось: соединения
# наружу открывает сам роутер, поэтому они идут по его обычной таблице
# маршрутизации — через podkop со всеми его списками. Телефон на мобильном
# интернете получает ту же маршрутизацию, что и устройства дома.
#
USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/openflux
CONF=/etc/openflux/openflux.env
WORKDIR=/etc/openflux

start_service() {
    [ -x "${PROG}" ] || { echo "openflux: нет ${PROG}"; return 1; }
    [ -r "${CONF}" ] || { echo "openflux: нет ${CONF}"; return 1; }

    # shellcheck source=/dev/null
    . "${CONF}"

    [ -r "${KEYFILE}" ] || { echo "openflux: нет ключа ${KEYFILE}"; return 1; }

    # Адрес носителя можно держать в отдельном файле. Для cupsonline это
    # единственный разумный способ: список комнат — строка в сотни символов,
    # и в командную строку BusyBox она целиком не влезает.
    if [ -z "${URL}" ] && [ -n "${URL_FILE}" ] && [ -r "${URL_FILE}" ]; then
        URL="$(cat "${URL_FILE}")"
    fi

    # Один транспорт или список. Список нужен, когда какой-то из них требует
    # капчу: приложение решает её через уже работающий транспорт, а капризный
    # поднимается следом. В одиночном режиме такую проверку показать некому.
    # Кавычек внутри значения быть не должно: аргумент уходит в procd как есть,
    # без разбора оболочкой, и они попали бы в имя транспорта.
    if [ -n "${TRANSPORTS}" ]; then
        TRANSPORT_ARG="--transports=${TRANSPORTS}"
        FIRST_TRANSPORT="${TRANSPORTS%%[:,]*}"
    else
        TRANSPORT_ARG="--transport=${TRANSPORT:-cupsonline}"
        FIRST_TRANSPORT="${TRANSPORT:-cupsonline}"
    fi

    # cupsonline умеет стартовать без адреса: тогда узел сам создаёт комнаты и
    # печатает их список (см. README — его нужно сохранить в URL_FILE и отдать
    # клиенту). Остальным транспортам адрес обязателен.
    if [ -z "${URL}" ] && [ "${FIRST_TRANSPORT}" != "cupsonline" ]; then
        echo "openflux: в ${CONF} не задан ни URL, ни читаемый URL_FILE"
        return 1
    fi

    # Режим l3 быстрее, но на роутере он ломает передачу — пакеты перестают
    # ходить вовсе, видимо из-за podkop и правил межсетевого экрана. Поэтому
    # по умолчанию l4; менять осознанно через MODE= в настройках.
    set -- --role=exit --mode="${MODE:-l4}" ${TRANSPORT_ARG} \
        --encryption-key-file="${KEYFILE}" \
        --cookie-store="${WORKDIR}/cookies.json"
    [ -n "${URL}" ] && set -- "$@" --url="${URL}"
    [ -n "${EXTRA_ARGS}" ] && set -- "$@" ${EXTRA_ARGS}

    procd_open_instance openflux
    # Переменные окружения из настроек, через пробел. Ими задаются вещи, под
    # которые нет флагов: главное — CUPS_ROOMS, число комнат у cupsonline, а в
    # новом режиме это число полос, по которым размазан поток. По умолчанию их
    # четыре, потолок 64, и каждая отдаёт порядка 130–200 КБ/с.
    # shellcheck disable=SC2086
    [ -n "${ENV}" ] && procd_set_param env ${ENV}
    # Рабочий каталог procd не задаёт, а узел по умолчанию кладёт cookie по
    # относительному пути — то есть в корень. Поэтому путь к ним задаём явно и
    # запускаем бинарник напрямую: через /bin/sh -c весь вывод уходил в журнал
    # под тегом sh, и `logread -e openflux` ничего не находил.
    procd_set_param command "${PROG}" "$@"
    # Перезапуск при падении: не чаще 5 секунд, без ограничения числа попыток
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/openflux.pid
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "openflux"
}
